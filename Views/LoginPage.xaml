<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="TCCLume.Views.LoginPage"
    BackgroundColor="#070812"
    NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="30,60"
            Spacing="20">

            <Image
                Source="Lume.png"
                HeightRequest="500"
                WidthRequest="500"
                Margin="0,-150,0,-240"
                HorizontalOptions="Center"
                Aspect="AspectFit"/>

            <Label
                 Text="Lume"
                    FontSize="50"
                    FontAttributes="Bold"
                    TextColor="#F2C94C"
                    HorizontalOptions="Center"
                    Margin="0,-10,0,0"/>

            <Label
                Text="ADICIONE UM BRILHO A MAIS NAS SUAS FINANÇAS!"
                TextColor="#8A8FB5"
                FontAttributes="Bold"
                HorizontalOptions="Center"
                FontSize="16"/>

            <Label
                Text="Seja bem-vindo!👋"
                FontSize="36"
                FontAttributes="Bold"
                TextColor="White"/>

            <Label
                Text="Entre na sua conta"
                TextColor="#8A8FB5"
                FontSize="20"
                FontAttributes="Bold"/>

            <!-- EMAIL -->
            <Entry
                x:Name="EmailEntry"
                Placeholder="E-mail"
                Keyboard="Email"
                TextColor="White"
                PlaceholderColor="#8A8FB5"
                BackgroundColor="#121424"
                Margin="0,0,0,0"/>

            <!-- SENHA -->
            <Grid>

                <Entry
                    x:Name="PasswordEntry"
                    Placeholder="Senha"
                    IsPassword="True"
                    TextColor="White"
                    PlaceholderColor="#8A8FB5"
                    BackgroundColor="#121424"/>

                <ImageButton
                    x:Name="PasswordVisibilityButton"
                    Grid.Column="1"
                    Source="eye.png"
                    BackgroundColor="Transparent"
                    HeightRequest="36"
                    WidthRequest="45"
                    Margin="1812,0,0,0"
                    Clicked="PasswordVisibilityButton_Clicked"/>

            </Grid>

            <!-- LOGIN -->
            <Button
                Text="Entrar"
                HeightRequest="60"
                CornerRadius="18"
                BackgroundColor="#F2C94C"
                TextColor="Black"
                FontAttributes="Bold"
                Clicked="LoginButton_Clicked"/>

            <!-- CRIAR CONTA -->
            <Button
                Text="Criar Conta"
                BackgroundColor="Transparent"
                TextColor="#F2C94C"
                Clicked="OnCreateAccountClicked"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>