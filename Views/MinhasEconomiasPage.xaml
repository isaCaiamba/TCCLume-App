<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCCLume.Views.MinhasEconomiasPage"
    BackgroundColor="#070812"
    Title="Minhas Economias">

    <ScrollView>

        <VerticalStackLayout
            Padding="20"
            Spacing="18">

            <!-- ===================================== -->
            <!-- TOPO -->
            <!-- ===================================== -->

            <Grid
                ColumnDefinitions="Auto,*"
                Margin="0,10,0,0">

                <Button
                    Text="☰"
                    FontSize="28"
                    BackgroundColor="Transparent"
                    TextColor="#F2C94C"
                    HorizontalOptions="Start"
                    VerticalOptions="Center"
                    Clicked="MenuButton_Clicked"/>

                <VerticalStackLayout
                    Grid.Column="1"
                    Spacing="2"
                    VerticalOptions="Center">

                    <Label
                        Text="Minhas Economias"
                        FontSize="22"
                        FontAttributes="Bold"
                        TextColor="White"
                        HorizontalOptions="End"/>

                    <Label
                        Text="Alcance seus objetivos"
                        FontSize="13"
                        TextColor="#A8AFB5"
                        HorizontalOptions="End"/>

                </VerticalStackLayout>

            </Grid>


            <!-- ===================================== -->
            <!-- RESUMO -->
            <!-- ===================================== -->

            <Frame
                BackgroundColor="#121424"
                BorderColor="#2A2D3E"
                CornerRadius="20"
                Padding="20">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="💰 TOTAL GUARDADO"
                        FontSize="12"
                        FontAttributes="Bold"
                        TextColor="#A8AFB5"/>

                    <Label
                        x:Name="TotalSavedLabel"
                        Text="R$ 0,00"
                        FontSize="32"
                        FontAttributes="Bold"
                        TextColor="#F2C94C"/>

                    <Label
                        x:Name="GoalsCountLabel"
                        Text="0 metas ativas"
                        FontSize="13"
                        TextColor="#A8AFB5"/>

                </VerticalStackLayout>

            </Frame>


            <!-- ===================================== -->
            <!-- TÍTULO DAS METAS -->
            <!-- ===================================== -->

            <Grid
                ColumnDefinitions="*,Auto"
                Margin="0,5,0,0">

                <Label
                    Text="Minhas metas"
                    FontSize="20"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalOptions="Center"/>

                <Button
                    Grid.Column="1"
                    Text="+ Nova meta"
                    FontSize="12"
                    BackgroundColor="#F2C94C"
                    TextColor="Black"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    Padding="12,8"
                    Clicked="NewGoalButton_Clicked"/>

            </Grid>


            <!-- ===================================== -->
            <!-- LISTA DE METAS -->
            <!-- ===================================== -->

            <VerticalStackLayout
                x:Name="GoalsLayout"
                 Spacing="14">

            </VerticalStackLayout>


            <!-- ===================================== -->
            <!-- INFORMAÇÃO -->
            <!-- ===================================== -->

            <Frame
                BackgroundColor="#121424"
                BorderColor="#2A2D3E"
                CornerRadius="20"
                Padding="20"
                Margin="0,5,0,20">

                <VerticalStackLayout
                    Spacing="8">

                    <Label
                        Text="✨ Dica do Lume"
                        FontSize="17"
                        FontAttributes="Bold"
                        TextColor="#F2C94C"/>

                    <Label
                        Text="Definir metas ajuda você a transformar seus planos em objetivos financeiros mais claros."
                        FontSize="14"
                        TextColor="White"/>

                </VerticalStackLayout>

            </Frame>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>