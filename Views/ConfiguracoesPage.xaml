<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TCCLume.Views.ConfiguracoesPage"
             BackgroundColor="#070812"
             NavigationPage.HasNavigationBar="False">

    <ScrollView>

        <VerticalStackLayout
            Padding="18,40,18,30"
            Spacing="18">

            <!-- CABEÇALHO -->

            <Grid
                ColumnDefinitions="Auto,*">

                <Button
                    Grid.Column="0"
                    Text="☰"
                    FontSize="25"
                    BackgroundColor="Transparent"
                    TextColor="#F2C94C"
                    WidthRequest="45"
                    HeightRequest="45"
                    Clicked="MenuButton_Clicked"/>

                <Label
                    Grid.Column="1"
                    Text="Configurações"
                    FontSize="28"
                    FontAttributes="Bold"
                    TextColor="White"
                    VerticalTextAlignment="Center"
                    HorizontalTextAlignment="Center"
                    Margin="0,0,45,0"/>

            </Grid>


            <!-- CONTA -->

            <Label
                Text="CONTA"
                FontSize="12"
                FontAttributes="Bold"
                TextColor="#F2C94C"
                Margin="5,5,0,0"/>


            <Border
                BackgroundColor="#121424"
                Stroke="#2A2D3E"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 18"
                Padding="16">

                <VerticalStackLayout
                    Spacing="0">


                    <!-- NOME -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Padding="0,8">

                        <Label
                            Text="👤"
                            FontSize="22"
                            VerticalTextAlignment="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Spacing="2">

                            <Label
                                Text="Nome"
                                FontSize="12"
                                TextColor="#8E93A3"/>

                            <Label
                                x:Name="NameLabel"
                                Text="Usuário"
                                FontSize="16"
                                TextColor="White"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="28"
                            TextColor="#777D8D"
                            VerticalTextAlignment="Center"/>

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="AlterarNome_Tapped"/>

                        </Grid.GestureRecognizers>

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#2A2D3E"/>


                    <!-- EMAIL -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Padding="0,12,0,8">

                        <Label
                            Text="✉"
                            FontSize="22"
                            VerticalTextAlignment="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Spacing="2">

                            <Label
                                Text="E-mail"
                                FontSize="12"
                                TextColor="#8E93A3"/>

                            <Label
                                x:Name="EmailLabel"
                                Text="email@email.com"
                                FontSize="15"
                                TextColor="White"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="28"
                            TextColor="#777D8D"
                            VerticalTextAlignment="Center"/>

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="AlterarEmail_Tapped"/>

                        </Grid.GestureRecognizers>

                    </Grid>


                    <BoxView
                        HeightRequest="1"
                        BackgroundColor="#2A2D3E"/>


                    <!-- SENHA -->

                    <Grid
                        ColumnDefinitions="Auto,*,Auto"
                        Padding="0,12,0,8">

                        <Label
                            Text="🔒"
                            FontSize="22"
                            VerticalTextAlignment="Center"/>

                        <VerticalStackLayout
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            Spacing="2">

                            <Label
                                Text="Senha"
                                FontSize="12"
                                TextColor="#8E93A3"/>

                            <Label
                                Text="Alterar senha"
                                FontSize="15"
                                TextColor="White"/>

                        </VerticalStackLayout>

                        <Label
                            Grid.Column="2"
                            Text="›"
                            FontSize="28"
                            TextColor="#777D8D"
                            VerticalTextAlignment="Center"/>

                        <Grid.GestureRecognizers>

                            <TapGestureRecognizer
                                Tapped="AlterarSenha_Tapped"/>

                        </Grid.GestureRecognizers>

                    </Grid>

                </VerticalStackLayout>

            </Border>

            <!-- ESPAÇO -->

            <BoxView
                HeightRequest="20"
                BackgroundColor="Transparent"/>


            <!-- SAIR -->

            <Button
                Text="Sair da conta"
                FontSize="16"
                FontAttributes="Bold"
                TextColor="#FF5B5B"
                BackgroundColor="#121424"
                BorderColor="#3A2025"
                BorderWidth="1"
                CornerRadius="16"
                HeightRequest="55"
                Clicked="Sair_Clicked"/>


            <!-- VERSÃO -->

            <Label
                Text="TCCLume • Lume&#10;Versão 1.0"
                FontSize="11"
                TextColor="#555B6B"
                HorizontalTextAlignment="Center"
                Margin="0,0,0,10"/>

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>